{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "buildCommand": "echo 'Using precompiled web build'",
  "outputDirectory": "verdi-proto-main/build/web",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
